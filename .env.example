# Local Postgres (Docker Desktop):
#   docker run -d --name hush-pg -e POSTGRES_PASSWORD=hush -e POSTGRES_DB=hush -p 5433:5432 postgres:16-alpine
DATABASE_URL=postgres://postgres:hush@localhost:5433/hush

# Integration tests use a separate database (created automatically by the test setup).
DATABASE_URL_TEST=postgres://postgres:hush@localhost:5433/hush_test

PORT=4620
